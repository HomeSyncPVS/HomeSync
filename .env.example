PROJECT_NAME="HomeSync Authentication Service"
API_V1_STR="/api/v1"
SECRET_KEY="homesyncofficialsignature"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# PostgreSQL Database Settings
# Set DATABASE_URL to your Supabase or local PostgreSQL URL (e.g. postgresql+asyncpg://...)
POSTGRES_SERVER=localhost
POSTGRES_USER=ems_user
POSTGRES_PASSWORD=12345
POSTGRES_DB=ems_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://ems_user:12345@localhost:5432/ems_db

# Redis Settings
USE_REDIS=False
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0

# Supabase Settings
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_BUCKET_NAME="profile-images"

# OAuth Settings
GOOGLE_CLIENT_ID="google-client-id"
GOOGLE_CLIENT_SECRET="google-client-secret"
APPLE_CLIENT_ID="apple-client-id"
APPLE_CLIENT_SECRET="apple-client-secret"

# Mail Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER="noreplyhomesyncofficial@gmail.com"
SMTP_PASSWORD="your-smtp-app-password"
EMAILS_FROM_EMAIL="noreplyhomesyncofficial@gmail.com"
EMAILS_FROM_NAME="HomeSync"

ENVIRONMENT=development
