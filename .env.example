PROJECT_NAME="HomeSync Authentication Service"
API_V1_STR="/api/v1"
# Generate a unique value for each environment, for example:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY="replace-this-with-a-unique-random-secret-key-at-least-64-characters-long"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# PostgreSQL Database Settings
# Set DATABASE_URL to your Supabase or local PostgreSQL URL (e.g. postgresql+asyncpg://...)
POSTGRES_SERVER=localhost
POSTGRES_USER=ems_user
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DB=ems_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://ems_user:your-postgres-password@localhost:5432/ems_db

# Redis Settings
USE_REDIS=False
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0

# Supabase Settings
USE_SUPABASE_AUTH=False
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_BUCKET_NAME="profile-images"

# OAuth Settings
GOOGLE_CLIENT_ID="google-client-id"
GOOGLE_CLIENT_SECRET="google-client-secret"
APPLE_CLIENT_ID="apple-client-id"
APPLE_CLIENT_SECRET="apple-client-secret"

# Email Delivery Provider (gmail | brevo_smtp | brevo_api | mock)
EMAIL_PROVIDER=gmail

# Gmail SMTP Settings
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_SMTP_USER="your-email@gmail.com"
GMAIL_SMTP_PASSWORD="your-google-app-password"
GMAIL_FROM_EMAIL="your-email@gmail.com"
GMAIL_FROM_NAME="HomeSync"

# Brevo SMTP Settings
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER="your-email@example.com"
BREVO_SMTP_USERNAME="your-brevo-smtp-key@smtp-brevo.com"
BREVO_SMTP_PASSWORD="your-brevo-smtp-password"
BREVO_FROM_EMAIL="your-email@example.com"
BREVO_FROM_NAME="HomeSync"

# Brevo HTTP API Settings
BREVO_API_KEY="your-brevo-api-key"
BREVO_SENDER_EMAIL="your-email@example.com"
BREVO_SENDER_NAME="HomeSync"

ENVIRONMENT=development
